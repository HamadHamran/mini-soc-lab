<group name="mini_soc,honeypot,cowrie,">

  <rule id="100500" level="3">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>SOC-HP-000: Cowrie honeypot event $(eventid) from $(src_ip)</description>
  </rule>

  <rule id="100501" level="5">
    <if_sid>100500</if_sid>
    <field name="eventid">^cowrie.session.connect$</field>
    <description>SOC-HP-001: New connection to SSH honeypot from $(src_ip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100502" level="6">
    <if_sid>100500</if_sid>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>SOC-HP-002: Honeypot login failed for user $(username) from $(src_ip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100503" level="10" frequency="5" timeframe="120" ignore="120">
    <if_matched_sid>100502</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>SOC-HP-003: Brute force against SSH honeypot from $(src_ip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100504" level="12">
    <if_sid>100500</if_sid>
    <field name="eventid">^cowrie.login.success$</field>
    <description>SOC-HP-004: Attacker logged in to SSH honeypot as $(username) from $(src_ip)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100505" level="12">
    <if_sid>100500</if_sid>
    <field name="eventid">^cowrie.command.input$</field>
    <description>SOC-HP-005: Attacker command on honeypot from $(src_ip): $(input)</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>

  <rule id="100506" level="14">
    <if_sid>100500</if_sid>
    <field name="eventid">^cowrie.session.file_download$</field>
    <description>SOC-HP-006: Attacker downloaded a file to the honeypot from $(url)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

</group>
