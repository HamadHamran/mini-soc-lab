<group name="mini_soc,fim,">

  <rule id="100400" level="12">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/srv/sensitive/</field>
    <description>SOC-FIM-001: Sensitive file changed, added or deleted: $(file)</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>

  <rule id="100401" level="12">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/sudoers</field>
    <description>SOC-FIM-002: Sudoers configuration changed: $(file)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

</group>
